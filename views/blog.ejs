<!DOCTYPE html>
<html lang="it">
  <head>
    <%- include('partials/general/head') %>
    <title>Blog - Promontolio</title>
  </head>
  <body>
    <header class="blog-header">
      <nav class="blog-nav">
        <div class="logo">
          <img
            class="blog-logo-img"
            src="/image/logo-promontolio.png"
            alt="Promontolio blog logo"
            loading="lazy"
          />
        </div>
        <div
          class="hamburger"
          id="hamburger"
          aria-label="Apri menu"
          aria-expanded="false"
          tabindex="0"
        >
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="nav-form">
          <ul class="blog-nav-list" id="navLinks">
            <li class="blog-nav-item"><a href="/">Home page</a></li>
            <li class="blog-nav-item"><a href="/blog">Blog</a></li>
          </ul>
          <form class="blog-search" action="/blog" method="get">
            <input
              type="text"
              name="q"
              placeholder="Cerca articoli..."
              aria-label="Cerca articoli"
            />
            <button type="submit">
              <i class="fas fa-search"></i>
            </button>
          </form>
        </div>
        <div class="blog-nav-overlay" id="navOverlay"></div>
      </nav>
    </header>

    <!-- Hero Banner -->
    <div class="blog-hero-banner">
      <h1 class="blog-hero-title">Il nostro Blog</h1>
      <p class="blog-hero-subtitle">Ricette, consigli e storie sull&apos;olio extravergine biologico del Gargano</p>
    </div>

    <!-- prettier-ignore -->
    <main class="blog-home">
  <div class="container container-blog">

    <%
      const categoryLabels = {
        OLIVE_OIL_GUIDE: "Guida all'Olio",
        RECIPES: 'Ricette',
        HEALTH_BENEFITS: 'Salute',
        PRODUCTION: 'Produzione',
        NEWS: 'News'
      };
      const categoryClasses = {
        OLIVE_OIL_GUIDE: 'cat-olive',
        RECIPES: 'cat-recipes',
        HEALTH_BENEFITS: 'cat-health',
        PRODUCTION: 'cat-production',
        NEWS: 'cat-news'
      };
    %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (articles && articles.length > 0) { %>

    <div class="blog-section-header">
      <h2 class="blog-section-title">
        <i class="fas fa-newspaper"></i>
        Articoli recenti
      </h2>
      <span class="blog-count"><%= articles.length %> articoli</span>
    </div>

    <div class="articles-list">
      <% articles.forEach(function(article) {
        const readTime = Math.ceil(
          (article.content ? article.content.replace(/<[^>]*>/g, '').split(' ').length : 100) / 200
        );
        const excerpt = article.excerpt
          ? article.excerpt
          : (article.content ? article.content.replace(/<[^>]*>/g, '').substring(0, 160) + '…' : '');
        const catLabel = categoryLabels[article.category] || '';
        const catClass = categoryClasses[article.category] || '';
      %>
      <article class="article-card">
        <div class="article-img">
          <img
            class="blog-card-img"
            src="<%= article.featuredImage ? article.featuredImage : '/image/UlivoBlogCard.webp' %>"
            alt="<%= article.title %> — Promontolio"
            loading="lazy"
          />
          <% if (catLabel) { %>
          <span class="cat-badge <%= catClass %> article-img-badge"><%= catLabel %></span>
          <% } %>
        </div>

        <div class="article-body">
          <h2 class="article-title"><%= article.title %></h2>

          <p class="article-excerpt"><%= excerpt %></p>

          <div class="article-meta">
            <% if (article.author) { %>
            <span class="meta-item">
              <i class="fas fa-user"></i>
              <%= article.author.username %>
            </span>
            <% } %>
            <span class="meta-item">
              <i class="fas fa-calendar-alt"></i>
              <%= new Date(article.createdAt).toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric' }) %>
            </span>
            <span class="meta-item">
              <i class="fas fa-clock"></i>
              <%= readTime %> min
            </span>
            <% if (article.viewCount) { %>
            <span class="meta-item">
              <i class="fas fa-eye"></i>
              <%= article.viewCount %>
            </span>
            <% } %>
          </div>

          <div class="blog-btn-container">
            <a class="blog-btn-main" href="/blog/<%= article.slug %>">
              Leggi l&apos;articolo
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </article>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
    <nav class="pagination-nav" aria-label="Paginazione blog">
      <div class="pagination-container">
        <% if (pagination.currentPage > 1) { %>
        <a
          href="<%= pagination.currentPage === 2 ? '/blog' : '/blog/page/' + (pagination.currentPage - 1) %>"
          class="pagination-btn pagination-prev"
        >
          ← Precedente
        </a>
        <% } %>

        <div class="pagination-numbers">
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <% if (i === pagination.currentPage) { %>
            <span class="pagination-number active"><%= i %></span>
            <% } else { %>
            <a href="<%= i === 1 ? '/blog' : '/blog/page/' + i %>" class="pagination-number"><%= i %></a>
            <% } %>
          <% } %>
        </div>

        <% if (pagination.currentPage < pagination.totalPages) { %>
        <a href="/blog/page/<%= pagination.currentPage + 1 %>" class="pagination-btn pagination-next">
          Successiva →
        </a>
        <% } %>
      </div>
    </nav>
    <% } %>

    <% } else { %>
    <div class="no-articles">
      <div class="no-articles-content">
        <i class="fas fa-newspaper no-articles-icon"></i>
        <h2>Nessun articolo ancora</h2>
        <p>Stiamo preparando contenuti di qualità per te. Torna presto!</p>
      </div>
    </div>
    <% } %>

  </div>
</main>

    <%- include('partials/general/footer') %>
    <script src="/js/script.js" defer></script>
  </body>
</html>
