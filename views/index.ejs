<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body>
    <% const copy = pageCopy || {}; %>
    <% const hero = copy.hero || {}; %>
    <% const sections = copy.sections || []; %>
    <% const sectionOne = sections[0] || {}; %>
    <% const sectionTwo = sections[1] || {}; %>
    <% const sectionThree = sections[2] || {}; %>
    <% const sectionFour = sections[3] || {}; %>
    <%- include('./partials/general/navbar.ejs') %>

    <header class="home-header">
      <section class="hero container">
        <div class="hero__content">
          <h1 class="hero__title">
            <span class="hero__title--highlight"><%= hero.titleHighlight || '' %></span>
          </h1>
          <h2 class="hero__subtitle">
            <span class="hero__brand"><%= hero.subtitleBrand || 'Promontolio' %></span>
            <span class="hero__slogan"><%= hero.slogan || '' %></span>
          </h2>
          <p class="hero__description"><%= hero.description || '' %></p>
        </div>
        <div class="hero__actions slideInDown">
          <a class="btn-primary" href="/product"><%= hero.primaryCta || 'Kontaktieren Sie uns' %></a>
        </div>
      </section>
    </header>

    <main class="home-main">
      <div class="container">
        <h2 class="section-title scroll-fade-up">
          <%= sectionOne.title || '' %>
        </h2>

        <article class="feature-grid scroll-fade-up">
          <div class="feature-grid__image feature-grid__image--apulia"></div>
          <div class="feature-grid__text">
            <h3 class="feature-grid__title"><%= sectionOne.features && sectionOne.features[0] ? sectionOne.features[0].title : '' %></h3>
            <p><%= sectionOne.features && sectionOne.features[0] ? sectionOne.features[0].text : '' %></p>
            <div class="feature-grid__banner">
              <img
                class="banner-img"
                src="../image/promontolio-banner.png"
                alt="Promontolio Premium Banner"
                loading="lazy"
              />
            </div>
          </div>
        </article>
      </div>

      <section class="impact-section impact--quality">
        <div class="container impact-section__content">
          <span class="impact-section__badge scroll-fade-up"><%= sectionTwo.badge || '' %></span>
          <h3 class="impact-section__title scroll-fade-up"><%= sectionTwo.title || '' %></h3>
          <p class="impact-section__description scroll-fade-up"><%= sectionTwo.text || '' %></p>
          <div class="impact-section__actions scroll-fade-up">
            <a href="/product" class="btn-primary"><%= sectionTwo.ctaPrimary || 'Jetzt Probieren' %></a>
            <a href="/about" class="btn-outline-white"><%= sectionTwo.ctaSecondary || 'Unser Zertifikat' %></a>
          </div>
        </div>
      </section>

      <div class="container">
        <article class="feature-grid feature-grid--reverse scroll-fade-up">
          <div class="feature-grid__text">
            <h3 class="feature-grid__title"><%= sectionOne.features && sectionOne.features[1] ? sectionOne.features[1].title : '' %></h3>
            <p><%= sectionOne.features && sectionOne.features[1] ? sectionOne.features[1].text : '' %></p>
          </div>
          <div
            class="feature-grid__image feature-grid__image--terroir"
            role="img"
            aria-label="Panorama delle colline pugliesi con ulivi secolari affacciati sul mare cristallino"
          ></div>
        </article>

        <article class="feature-grid scroll-fade-up">
          <div class="feature-grid__text">
            <h3 class="feature-grid__title"><%= sectionOne.features && sectionOne.features[2] ? sectionOne.features[2].title : '' %></h3>
            <ul class="check-list">
              <% (sectionOne.features && sectionOne.features[2] && sectionOne.features[2].bullets ? sectionOne.features[2].bullets : []).forEach(function(bullet) { %>
              <li class="check-list__item"><i class="fas fa-check"></i> <%= bullet %></li>
              <% }); %>
            </ul>
            <div class="feature-grid__banner">
              <img
                class="organic-logo"
                src="../image/OrganicLogo.png"
                alt="Bio-Zertifizierung Logo"
                loading="lazy"
              />
            </div>
          </div>
          <div
            class="feature-grid__image feature-grid__image--benefits"
            role="img"
            aria-label="Dettaglio di olio d'oliva dorato versato su pane fresco con olive e foglie di basilico"
          ></div>
        </article>
      </div>
      <section class="impact-section impact--guide scroll-fade-up">
        <div class="container impact-section__content">
          <span class="impact-section__badge"><%= sectionFour.badge ||'' %></span>
          <h3 class="impact-section__title"><%= sectionFour.subtitle || '' %></h3>
          <p class="impact-section__description"><%= sectionFour.text || '' %></p>
          <div class="impact-section__actions">
            <a href="/olivenoel-guide" class="btn-primary"><%= sectionFour.cta || 'Kostenlosen Guide laden' %></a>
          </div>
        </div>
      </section>

      <div class="container">
        <article class="feature-grid feature-grid--reverse scroll-fade-up">
          <div class="feature-grid__text">
            <h3 class="feature-grid__title"><%= sectionOne.features && sectionOne.features[3] ? sectionOne.features[3].title : '' %></h3>
            <p><%= sectionOne.features && sectionOne.features[3] ? sectionOne.features[3].text : '' %></p>
          </div>
          <div
            class="feature-grid__image feature-grid__image--harvest"
            role="img"
            aria-label="Raccolta manuale delle olive"
          ></div>
        </article>
      </div>

      <section class="impact-section impact--sustainability">
        <div class="container impact-section__content">
          <span class="impact-section__badge scroll-fade-up"><%=sectionThree.badge || ''%> </span>
          <h3 class="impact-section__title scroll-fade-up"><%= sectionThree.title || '' %></h3>
          <p class="impact-section__description scroll-fade-up"><%= sectionThree.text || '' %></p>
          <div class="impact-stats scroll-fade-up">
            <% (sectionThree.stats || []).forEach(function(stat) { %>
            <div class="impact-stats__item">
              <span class="impact-stats__number"><%= stat.value %></span>
              <span class="impact-stats__label"><%= stat.label %></span>
            </div>
            <% }); %>
          </div>
          <div class="impact-section__actions scroll-fade-up">
            <a href="/about" class="btn-primary"><%= sectionThree.cta || 'Unsere Mission' %></a>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>
  </body>
</html>
