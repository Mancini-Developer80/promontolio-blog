<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body>
    <% const ui = (pageCopy && pageCopy.ui) || {}; %>
    <header class="blog-header">
      <nav class="blog-nav">
        <div class="logo">
          <img
            class="blog-logo-img"
            src="/image/logo-promontolio.png"
            alt="Promontolio blog logo"
            loading="lazy"
          />
        </div>
        <div
          class="hamburger"
          id="hamburger"
          aria-label="Open menu"
          aria-expanded="false"
          tabindex="0"
        >
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="nav-form">
          <ul class="blog-nav-list" id="navLinks">
            <li class="blog-nav-item"><a href="/"><%= ui.homeLink || 'Home page' %></a></li>
            <li class="blog-nav-item"><a href="/blog"><%= ui.blogLink || 'Blog Home' %></a></li>
          </ul>
          <form class="blog-search" action="/blog" method="get">
            <input
              type="text"
              name="q"
              placeholder="<%= ui.searchPlaceholder || '' %>"
              aria-label="<%= ui.searchPlaceholder || '' %>"
            />
            <button type="submit">Search</button>
          </form>
        </div>
        <div class="blog-nav-overlay" id="navOverlay"></div>
      </nav>
    </header>

    <!-- prettier-ignore -->
    <main class="single-article">
  <!-- Hero Section -->
  <div class="article-hero">
    <div class="hero-content">
      <nav class="breadcrumb">
          <a href="/"><%= ui.breadcrumbHome || 'Home' %></a>
        <span class="separator">/</span>
          <a href="/blog"><%= ui.breadcrumbBlog || 'Blog' %></a>
        <span class="separator">/</span>
        <span class="current"><%= article.title %></span>
      </nav>
      <h1 class="article-hero-title"><%= article.title %></h1>
      <% if (article.excerpt) { %>
      <p class="article-lead"><%= article.excerpt %></p>
      <% } %>
      <div class="article-hero-meta">
        <div class="article-date-info">
          <i class="fas fa-calendar-alt"></i>
          <span class="publish-date">
            <%= new Date(article.createdAt || article.date || Date.now()).toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </span>
        </div>
        <div class="read-time">
          <i class="fas fa-clock"></i>
              <span><%= Math.ceil((article.content ? article.content.replace(/<[^>]*>/g, '').split(' ').length : 100) / 200) %> min di lettura</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Article Container -->
  <div class="article-container">
    <!-- Main Content -->
    <article class="article-main">

      <!-- Featured Image -->
      <div class="article-featured-image">
        <img
          src="<%= article.featuredImage ? article.featuredImage : '/image/organic-olive-harvest-extra-virgin-oil.webp' %>"
          alt="<%= article.title %> - Promontolio organic olive oil"
          loading="lazy"
        />
        <figcaption class="image-caption">
          Olio extravergine di oliva biologico del Gargano - Tradizione
          e qualità nella produzione artigianale
        </figcaption>
      </div>

      <div class="article-content-main"><%- article.content %></div>

      <!-- Article Footer -->
      <footer class="article-footer">
            <div class="article-tags">
              <span class="tag-label"><%= ui.tagsLabel || 'Tags:' %></span>
              <% if (article.tags && article.tags.length > 0) { %>
                <% article.tags.forEach(function(keyword) { %>
                  <span class="tag"><%= keyword.trim() %></span>
                <% }); %>
              <% } else { %>
              <span class="tag">Olio d'Oliva</span>
              <span class="tag">Tradizione</span>
              <span class="tag">Gargano</span>
              <span class="tag">Biologico</span>
              <% } %>
            </div>

            <div class="social-share">
              <span class="share-label"><%= ui.shareLabel || 'Condividi:' %></span>
              <a
                href="#"
                class="share-btn facebook"
                title="<%= ui.shareFacebook || 'Condividi su Facebook' %>"
              >
                <i class="fab fa-facebook-f"></i>
              </a>
              <a
                href="#"
                class="share-btn twitter"
                title="<%= ui.shareTwitter || 'Condividi su Twitter' %>"
              >
                <i class="fab fa-twitter"></i>
              </a>
              <a
                href="#"
                class="share-btn linkedin"
                title="<%= ui.shareLinkedIn || 'Condividi su LinkedIn' %>"
              >
                <i class="fab fa-linkedin-in"></i>
              </a>
              <a
                href="#"
                class="share-btn whatsapp"
                title="<%= ui.shareWhatsApp || 'Condividi su WhatsApp' %>"
              >
                <i class="fab fa-whatsapp"></i>
              </a>
            </div>

            <div class="article-navigation">
              <a href="/blog" class="nav-btn back-btn">
                <i class="fas fa-arrow-left"></i>
                <span><%= ui.backToBlog || 'Torna al Blog' %></span>
              </a>
              <a href="/product" class="nav-btn cta-btn">
                <i class="fas fa-shopping-cart"></i>
                <span><%= ui.buyNow || 'Acquista Ora' %></span>
              </a>
            </div>
      </footer>
    </article>
  </div>
</main>

<script src="/js/blog-article.js" defer></script>

    <%- include('partials/general/footer') %>
  </body>
</html>
