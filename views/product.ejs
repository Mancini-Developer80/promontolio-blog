<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body class="product-page">
    <% const copy = pageCopy || {}; %>
    <% const hero = copy.hero || {}; %>
    <% const product = copy.product || {}; %>
    <% const bundles = copy.bundles || []; %>
    <% const b2b = copy.b2b || {}; %>
    <% const details = copy.details || {}; %>
    <% const craft = copy.craft || {}; %>
    <% const guide = copy.guide || {}; %>
    <%- include('./partials/general/navbar') %>

    <header class="header-product">
      <section class="product container">
        <div class="product-description content scroll-fade-up">
          <h1><%= hero.title || '' %></h1>
          <p><%= hero.text || '' %></p>
        </div>

        <div class="linea scroll-fade-up"></div>

        <div class="product-main-grid">
          <div class="bottiglia-bio-container scroll-fade-up">
            <img
              src="../image/BottigliaBio.png"
              alt="Bio-Olivenöl 0,75l Flasche - Promontolio"
              loading="lazy"
              class="img-fluid main-product-img"
            />
          </div>

          <div class="product-details scroll-fade-up">
            <div class="details-header">
              <span class="product-badge"><%= product.badge || '' %></span>
              <h2 class="product-title"><%= product.title || '' %></h2>
              <p class="product-subtitle"><%= product.subtitle || '' %></p>
            </div>

            <div class="package-selector">
              <% bundles.forEach(function(bundle, index) { %>
              <div class="package-card-wrapper">
                <input type="radio" name="bundle" id="pack<%= index === 0 ? '6' : '12' %>" value="<%= index === 0 ? '6' : '12' %>" <%= index === 0 ? 'checked' : '' %> />
                <label for="pack<%= index === 0 ? '6' : '12' %>" class="package-card <%= bundle.badge ? 'highlight' : '' %>">
                  <% if (bundle.badge) { %><span class="pack-badge"><%= bundle.badge %></span><% } %>
                  <span class="pack-name"><%= bundle.name %></span>
                  <span class="pack-price"><%= bundle.price %></span>
                  <span class="pack-detail"><%= bundle.detail %></span>
                </label>
              </div>
              <% }); %>
            </div>

            <button class="btn-main btn-add-cart"><%=product.addToCart || 'IN DEN WARENKORB' %></button>

            <div class="b2b-section scroll-fade-up">
              <div class="b2b-content">
                <h3><%= b2b.title || '' %></h3>
                <p><%= b2b.text || '' %></p>
                <a href="/contact" class="btn-outline-b2b"><%= b2b.cta || '' %></a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </header>

    <section class="product-values">
      <div class="content container">
        <div class="flex-about">
          <div class="about-text scroll-fade-up">
            <h2><%= details.title || '' %></h2>
            <table class="value-table">
              <tbody>
                <% (details.items || []).forEach(function(item) { %>
                <tr>
                  <td><strong><%= item.label %></strong></td>
                  <td><%= item.value %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div class="about-text scroll-fade-up">
            <h2><%= craft.title || '' %></h2>
            <p><%= craft.text || '' %></p>
          </div>
        </div>
      </div>
    </section>
    <section class="guide-download-section scroll-fade-up">
      <div class="container guide-flex">
        <div class="guide-image">
          <img
            src="/image/BottigliaBio.png"
            alt="Promontolio Guide Preview"
          />
        </div>
        <div class="guide-content">
          <span class="guide-badge"><%= guide.badge || '' %></span>
          <h2><%= guide.title || '' %></h2>
          <p><%= guide.text || '' %></p>
          <form class="guide-form" action="/subscribe" method="POST">
            <input type="hidden" name="source" value="product_quality_focus" />
            <input
              type="email"
              name="email"
              placeholder="<%= guide.emailPlaceholder || '' %>"
              autocomplete="email"
              required
            />
            <label class="guide-consent">
              <input type="checkbox" name="consent" value="true" required />
              <span><%= guide.consent || '' %> <a href="/datenschutz"><%= guide.privacyLink || '' %></a></span>
            </label>
            <div class="form-honeypot" aria-hidden="true">
              <label for="website-product">Website</label>
              <input type="text" id="website-product" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn-main"><%= guide.button || 'GUIDE HERUNTERLADEN' %></button>
            <p class="privacy-note"><%= guide.privacy || '' %></p>
          </form>
        </div>
      </div>
    </section>

    <%- include('partials/general/footer') %>
  </body>
</html>
