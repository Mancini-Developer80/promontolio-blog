<!DOCTYPE html>
<html lang="de">
  <head>
    <%- include('partials/general/head') %>
    <title>Kontakt & Anfragen - Promontolio</title>
  </head>
  <body class="contact-page">
    <%- include('partials/general/navbar.ejs') %>

    <div class="nav-spacer"></div>

    <main class="contact-container">
      <section class="contact-grid">
        <div class="contact-info">
          <span class="contact-badge">Kontakt</span>
          <h1>Lassen Sie uns über Olivenöl und den Gargano sprechen</h1>
          <p>
            Haben Sie Fragen zu unseren Bio-Produkten, benötigen Sie
            Informationen zum Territorium oder möchten Sie mehr über unsere
            Ernte erfahren? Wir sind für Sie da.
          </p>

          <div class="b2b-notice">
            <h3>Geschäftskunden & Gastronomie</h3>
            <p>
              Suchen Sie nach individuellen Angeboten für Ihr Restaurant oder
              Fachgeschäft? Fordern Sie hier ein maßgeschneidertes Angebot oder
              Informationen zu unseren Lieferkonditionen an.
            </p>
          </div>
        </div>

        <div class="contact-card">
          <form action="/contact" method="POST" class="contact-form">
            <div class="form-group">
              <label for="name">Name / Unternehmen</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Ihr Name o. Firmenname"
                required
              />
            </div>

            <div class="form-group">
              <label for="email">E-Mail-Adresse</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="beispiel@mail.de"
                required
              />
            </div>

            <div class="form-group">
              <label for="message">Ihre Anfrage</label>
              <textarea
                id="message"
                name="message"
                placeholder="Wie können wir Ihnen helfen?"
                required
              ></textarea>
            </div>

            <div id="form-feedback" class="form-feedback"></div>
            <button class="btn-send" type="submit">Nachricht senden</button>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>
    <script src="/js/contact.js"></script>
  </body>
</html>
