<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body class="contact-page">
    <% const copy = pageCopy || {}; %>
    <% const hero = copy.hero || {}; %>
    <% const b2b = copy.b2b || {}; %>
    <% const form = copy.form || {}; %>
    <%- include('partials/general/navbar.ejs') %>

    <div class="nav-spacer"></div>

    <main class="contact-container">
      <section class="contact-grid">
        <div class="contact-info">
          <span class="contact-badge"><%= hero.badge || '' %></span>
          <h1><%= hero.title || '' %></h1>
          <p><%= hero.text || '' %></p>

          <div class="b2b-notice">
            <h3><%= b2b.title || '' %></h3>
            <p><%= b2b.text || '' %></p>
          </div>
        </div>

        <div class="contact-card">
          <form action="/contact" method="POST" class="contact-form">
            <div class="form-group">
              <label for="name"><%= form.nameLabel || '' %></label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="<%= form.namePlaceholder || '' %>"
                required
              />
            </div>

            <div class="form-group">
              <label for="email"><%= form.emailLabel || '' %></label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="<%= form.emailPlaceholder || '' %>"
                required
              />
            </div>

            <div class="form-group">
              <label for="message"><%= form.messageLabel || '' %></label>
              <textarea
                id="message"
                name="message"
                placeholder="<%= form.messagePlaceholder || '' %>"
                required
              ></textarea>
            </div>

            <div id="form-feedback" class="form-feedback"></div>
            <button class="btn-send" type="submit"><%= form.submit || '' %></button>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>
    <script src="/js/contact.js"></script>
  </body>
</html>
