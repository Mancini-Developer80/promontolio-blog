<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body class="contact-page">
    <% const copy = pageCopy || {}; %>
    <% const hero = copy.hero || {}; %>
    <% const b2b = copy.b2b || {}; %>
    <% const form = copy.form || {}; %>
    <% const messages = copy.messages || {}; %>
    <% const feedbackStatus = typeof contactStatus !== 'undefined' ? contactStatus : ''; %>
    <% const feedbackMessage = feedbackStatus === 'success' ? messages.success : feedbackStatus === 'invalid' ? messages.invalid : feedbackStatus === 'error' ? messages.serverError : ''; %>
    <%- include('partials/general/navbar.ejs') %>

    <div class="nav-spacer"></div>

    <main class="contact-container">
      <section class="contact-grid">
        <div class="contact-info">
          <span class="contact-badge"><%= hero.badge || '' %></span>
          <h1><%= hero.title || '' %></h1>
          <p><%= hero.text || '' %></p>

          <div class="b2b-notice">
            <h3><%= b2b.title || '' %></h3>
            <p><%= b2b.text || '' %></p>
          </div>
        </div>

        <div class="contact-card">
          <form
            action="/contact"
            method="POST"
            class="contact-form"
            data-sending-message="<%= messages.sending || '' %>"
            data-connection-error="<%= messages.connectionError || '' %>"
          >
            <div class="form-group">
              <label for="name"><%= form.nameLabel || '' %></label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="<%= form.namePlaceholder || '' %>"
                autocomplete="name"
                minlength="2"
                maxlength="100"
                required
              />
            </div>

            <div class="form-group">
              <label for="email"><%= form.emailLabel || '' %></label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="<%= form.emailPlaceholder || '' %>"
                autocomplete="email"
                maxlength="254"
                required
              />
            </div>

            <div class="form-group">
              <label for="message"><%= form.messageLabel || '' %></label>
              <textarea
                id="message"
                name="message"
                placeholder="<%= form.messagePlaceholder || '' %>"
                minlength="10"
                maxlength="5000"
                rows="8"
                required
              ></textarea>
            </div>

            <div class="form-consent">
              <input type="checkbox" id="consent" name="consent" value="true" required />
              <label for="consent">
                <%= form.consentLabel || '' %>
                <a href="/datenschutz"><%= form.privacyLink || '' %></a>
              </label>
            </div>

            <div class="form-honeypot" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div
              id="form-feedback"
              class="form-feedback <%= feedbackStatus === 'success' ? 'success' : feedbackMessage ? 'error' : '' %>"
              role="status"
              aria-live="polite"
              <% if (feedbackMessage) { %>style="display: block"<% } %>
            ><%= feedbackMessage || '' %></div>
            <button class="btn-send" type="submit"><%= form.submit || '' %></button>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>
    <script src="/js/contact.js"></script>
  </body>
</html>
