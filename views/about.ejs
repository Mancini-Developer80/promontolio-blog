<!DOCTYPE html>
<html lang="de">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body>
    <header class="about-header">
      <%- include('partials/general/navbar') %>

      <section class="about-hero container">
        <div class="about-hero__content scroll-fade-up">
          <span class="about-hero__subtitle">Exklusive Einzellagen-Selektion</span>
          <h1 class="about-hero__title">Ein Erlebnis jenseits des Standards</h1>
          <p class="about-hero__text">
            Jede Ernte ist eine neue Suche nach Perfektion. Wir analysieren und
            verkosten hunderte proben, um die eine Partie zu finden, die den
            Namen Promontolio tragen darf. Ein zertifiziertes Elixier für
            Kenner, die Reinheit und Charakter zu schätzen wissen.
          </p>
        </div>
      </section>
    </header>

    <main class="about-main">
      <section class="container about-curator">
        <div class="flex-about">
          <div class="about-img scroll-fade-up">
            <img
              class="img-about"
              src="../image/cassoneOlive.jpg"
              alt="Selektion der Oliven - Promontolio Expertise"
              loading="lazy"
            />
          </div>
          <div class="about-text scroll-fade-up">
            <h2>Der Gaumen eines Experten</h2>
            <p>
              Hinter jeder Flasche Promontolio steht die Nase und der Gaumen eines
              <strong>zertifizierten Olivenölexperten</strong>. Wir produzieren
              nicht einfach nur Öl – wir wählen es aus.
            </p>
            <p>
              Jede Partie wird einer strengen sensorischen Prüfung unterzogen.
              Nur Öle mit perfekter Harmonie, komplexen Aromen und einer
              makellosen Struktur werden in unsere limitierte Kollektion
              aufgenommen.
            </p>
            <div class="badge-expert">Zertifizierter Verkoster & Selekteur</div>
          </div>
        </div>
      </section>

      <section class="about-sensoric">
        <div class="container">
          <h2 class="about-sensoric__title scroll-fade-up">
            Das sensorische Profil unserer Auswahl
          </h2>
          <div class="sensoric-grid scroll-fade-up">
            <div class="sensoric-item">
              <i class="fas fa-apple-alt" aria-hidden="true"></i>
              <h4>Fruchtigkeit</h4>
              <p>Noten von grünen Tomaten, Artischocken und frisch geschnittenem Gras.</p>
            </div>
            <div class="sensoric-item">
              <i class="fas fa-pepper-hot" aria-hidden="true"></i>
              <h4>Schärfe</h4>
              <p>Ein lebendiger, pfeffriger Abgang – das Zeichen für einen hohen Polyphenolgehalt.</p>
            </div>
            <div class="sensoric-item">
              <i class="fas fa-leaf" aria-hidden="true"></i>
              <h4>Bitterkeit</h4>
              <p>Ein eleganter Hauch von Wildkräutern, perfekt ausbalanciert.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="container about-quality scroll-fade-up">
        <div class="flex-about flex-about--reverse">
          <div class="about-img">
            <img
              class="img-about"
              src="../image/OliveInMano.webp"
              alt="Qualitätskontrolle Promontolio Laboranalyse"
              loading="lazy"
            />
          </div>
          <div class="about-text">
            <h2>Wissenschaft trifft Tradition</h2>
            <p>
              Unsere Leidenschaft wird durch Daten untermauert. Jede Selektion
              wird in spezialisierten Laboren analysiert, um einen Säuregrad
              nahe Null e una massima concentrazione di antiossidanti.
            </p>
            <p>
              Wir liefern Ihnen ein zertifiziertes Elixier für Ihr Wohlbefinden, 
              das den strengsten Elite-Standards entspricht.
            </p>
          </div>
        </div>
      </section>

      <section class="about-manifesto">
        <div class="container scroll-fade-up">
          <div class="manifesto-content">
            <span class="manifesto-label">Limitierte Selektion</span>
            <h2 class="manifesto-title">Gegen den Strom der Massenproduktion</h2>
            <p class="manifesto-text">
              Während Supermärkte auf Volumen setzen, konzentriert sich Promontolio auf das 
              <strong>Maximum des Möglichen</strong>. Unsere jährliche Menge ist streng limitiert durch die natürlichen Zyklen Apuliens.
            </p>
            <blockquote class="manifesto-quote">
              "Wir füllen nicht ab, was der Markt verlangt, sondern nur das, was meine Prüfung als Experte besteht."
            </blockquote>
          </div>
        </div>
      </section>

      <section class="about-download-immersive">
        <div class="immersive-overlay"></div>
        
        <div class="container immersive-content scroll-fade-up">
          <div class="download-badge">Exklusiver Guide</div>
          <h2 class="immersive-title">Il Compendio Promontolio</h2>
          <p class="immersive-lead">
            Entdecken Sie die Geheimnisse del apulischen Goldes. <br>
            20 Seiten über Sensorik, Rezepte und die wilde Seele del Gargano.
          </p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-error-immersive">
              <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
          <% } %>

          <form class="immersive-form" action="/subscribe" method="POST">
            <input type="hidden" name="source" value="about_page_immersive">
            
            <div class="immersive-input-group">
              <input 
                type="email" 
                name="email" 
                placeholder="Ihre E-Mail-Adresse" 
                required 
              />
              <button type="submit" id="submit-btn-about" class="btn-immersive">
                Jetzt Herunterladen
              </button>
            </div>

            <div class="immersive-gdpr">
              <input type="checkbox" id="consent-about" name="consent" required />
              <label for="consent-about">
                Ich akzeptiere die <a href="/datenschutz">Datenschutzbestimmungen</a>.
              </label>
            </div>
            <p class="form-disclaimer">Kostenloser Download. Kein Spam, nur Qualität.</p>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const consentCheckbox = document.getElementById('consent-about');
        const submitBtn = document.getElementById('submit-btn-about');

        const toggleButton = () => {
          if (consentCheckbox && submitBtn) {
            submitBtn.disabled = !consentCheckbox.checked;
            // L'opacità viene gestita meglio dal CSS con :disabled, 
            // ma lasciamo un piccolo feedback inline per sicurezza
            submitBtn.style.cursor = consentCheckbox.checked ? "pointer" : "not-allowed";
          }
        };

        consentCheckbox.addEventListener('change', toggleButton);
        toggleButton(); 
      });
    </script>
  </body>
</html>