<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body>
    <% const copy = pageCopy || {}; %>
    <% const hero = copy.hero || {}; %>
    <% const curator = copy.curator || {}; %>
    <% const sensoric = copy.sensoric || {}; %>
    <% const quality = copy.quality || {}; %>
    <% const manifesto = copy.manifesto || {}; %>
    <% const guide = copy.guide || {}; %>
    <header class="about-header">
      <%- include('partials/general/navbar') %>

      <section class="about-hero container">
        <div class="about-hero__content scroll-fade-up">
          <span class="about-hero__subtitle"><%= hero.subtitle || '' %></span>
          <h1 class="about-hero__title"><%= hero.title || '' %></h1>
          <p class="about-hero__text"><%= hero.text || '' %></p>
        </div>
      </section>
    </header>

    <main class="about-main">
      <section class="container about-curator">
        <div class="flex-about">
          <div class="about-img scroll-fade-up">
            <img
              class="img-about"
              src="../image/cassoneOlive.jpg"
              alt="Selektion der Oliven - Promontolio Expertise"
              loading="lazy"
            />
          </div>
          <div class="about-text scroll-fade-up">
            <h2><%= curator.title || '' %></h2>
            <% (curator.paragraphs || []).forEach(function(paragraph) { %>
            <p><%= paragraph %></p>
            <% }); %>
            <div class="badge-expert"><%= curator.badge || '' %></div>
          </div>
        </div>
      </section>

      <section class="about-sensoric">
        <div class="container">
          <h2 class="about-sensoric__title scroll-fade-up"><%= sensoric.title || '' %></h2>
          <div class="sensoric-grid scroll-fade-up">
            <% (sensoric.items || []).forEach(function(item) { %>
            <div class="sensoric-item">
              <i class="fas fa-leaf" aria-hidden="true"></i>
              <h4><%= item.title %></h4>
              <p><%= item.text %></p>
            </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="container about-quality scroll-fade-up">
        <div class="flex-about flex-about--reverse">
          <div class="about-img">
            <img
              class="img-about"
              src="../image/OliveInMano.webp"
              alt="Qualitätskontrolle Promontolio Laboranalyse"
              loading="lazy"
            />
          </div>
          <div class="about-text">
            <h2><%= quality.title || '' %></h2>
            <% (quality.paragraphs || []).forEach(function(paragraph) { %>
            <p><%= paragraph %></p>
            <% }); %>

            <% if (quality.buttonText) { %>
            <div class="quality__actions" style="margin-top: 2rem;">
              <a class="btn-primary" href="<%= quality.buttonUrl || '/prodotti' %>">
                <%= quality.buttonText %>
              </a>
            </div>
            <% } %>
          </div>
        </div>
      </section>

      <section class="about-manifesto">
        <div class="container scroll-fade-up">
          <div class="manifesto-content">
            <span class="manifesto-label"><%= manifesto.label || '' %></span>
            <h2 class="manifesto-title"><%= manifesto.title || '' %></h2>
            <p class="manifesto-text"><%= manifesto.text || '' %></p>
            <blockquote class="manifesto-quote"><%= manifesto.quote || '' %></blockquote>
          </div>
        </div>
      </section>

      <section class="about-download-immersive">
        <div class="immersive-overlay"></div>
        
        <div class="container immersive-content scroll-fade-up">
          <div class="download-badge"><%= guide.badge || '' %></div>
          <h2 class="immersive-title"><%= guide.title || '' %></h2>
          <p class="immersive-lead"><%= guide.lead || '' %></p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-error-immersive">
              <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
          <% } %>

          <form class="immersive-form" action="/subscribe" method="POST">
            <input type="hidden" name="source" value="about_page_immersive">
            
            <div class="immersive-input-group">
              <input 
                type="email" 
                name="email" 
                placeholder="<%= guide.emailPlaceholder || '' %>" 
                autocomplete="email"
                required 
              />
              <button type="submit" id="submit-btn-about" class="btn-immersive"><%= guide.submit || '' %></button>
            </div>

            <div class="immersive-gdpr">
              <input type="checkbox" id="consent-about" name="consent" required />
              <label for="consent-about">
                <%= guide.consent || '' %> <a href="/datenschutz">Datenschutzbestimmungen</a>.
              </label>
            </div>
            <div class="form-honeypot" aria-hidden="true">
              <label for="website-about">Website</label>
              <input type="text" id="website-about" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <p class="form-disclaimer"><%= guide.disclaimer || '' %></p>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>

    <script src="/js/about.js" defer></script>
  </body>
</html>