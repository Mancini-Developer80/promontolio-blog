<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body class="lp-body">
    <% const copy = pageCopy || {}; %>
    <% const hero = copy.hero || {}; %>
    <% const benefits = copy.benefits || []; %>
    <% const form = copy.form || {}; %>
    <% const trust = copy.trust || []; %>
    <%- include('./partials/general/navbar.ejs') %>

    <main class="lp-guide">
      <div class="container lp-guide__wrapper">
        <div class="lp-guide__visual">
          <div class="lp-guide__img-container">
            <img
              src="/image/promontolio-olive-oil-bottles.webp"
              alt="Promontolio Olivenöl Guide"
              class="lp-guide__img"
            />
          </div>
        </div>

        <div class="lp-guide__content">
          <span class="text-accent"><%= hero.badge || '' %></span>
          <h1><%= hero.title || '' %></h1>
          <p><%= hero.text || '' %></p>

          <ul class="benefit-list">
            <% benefits.forEach(function(item) { %>
            <li>
              <i class="fas fa-check-circle"></i>
              <span><strong><%= item.title %>:</strong> <%= item.text %></span>
            </li>
            <% }); %>
          </ul>

          <form
            class="lp-guide__form"
            id="guide-form"
            action="/subscribe"
            method="POST"
            data-sending-message="<%= form.sending || '' %>"
          >
            <input type="hidden" name="source" value="landing_page_guide" />
            <div class="input-group">
              <input
                type="email"
                name="email"
                id="email-input"
                placeholder="<%= form.emailPlaceholder || '' %>"
                autocomplete="email"
                maxlength="254"
                required
              />
            </div>

            <div class="consent-wrapper">
              <input type="checkbox" name="consent" id="consent" required />
              <label for="consent">
                <%= form.consentText || '' %> <a href="/datenschutz" target="_blank"><%= form.privacyLinkText || 'Datenschutz' %></a>.
              </label>
            </div>

            <div class="form-honeypot" aria-hidden="true">
              <label for="website-guide">Website</label>
              <input type="text" id="website-guide" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" id="submit-btn" class="btn-primary" disabled>
              <span class="btn-text"><%= form.button || '' %></span>
            </button>

            <p class="form-disclaimer">
              <i class="fas fa-lock"></i> <%= form.disclaimer || '' %>
            </p>
          </form>

          <div class="lp-guide__trust">
            <% trust.forEach(function(item) { %>
            <div class="trust-item">
              <i class="fas fa-check"></i>
              <span><%= item %></span>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/general/footer') %>

    <script src="/js/landing-page.js" defer></script>
  </body>
</html>
