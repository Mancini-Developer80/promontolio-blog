<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body class="thanks-page">
    <% const copy = pageCopy || {}; %>
    <%- include('partials/general/navbar') %>

    <main class="thanks-main">
    <div class="thanks-card scroll-fade-up visible">
    <div class="status-badge"><%= copy.statusBadge || 'Posteingang prüfen' %></div>
      <a href="/" class="btn-back-home">
        <i class="fas fa-arrow-left"></i> <%= copy.backHome || 'Zurück zur Startseite' %>
      </a>

    <h1 class="thanks-title"><%= title %></h1>

    <p class="thanks-text">
      <%= message %>
    </p>

    <% if (locals.downloadUrl) { %>
      <div class="download-container">
        <p class="download-label"><%= copy.downloadLabel || 'Ihre Datei ist bereit:' %></p>
        <a href="<%= downloadUrl %>" class="btn-download" download>
          <i class="fas fa-file-pdf"></i> <%= copy.downloadButton || 'Guide Herunterladen (PDF)' %>
        </a>
      </div>
    <% } %>
    <p class="thanks-text">
      <small style="color: #888">
        <%= copy.confirmationHint || 'Wir senden Ihnen den Guide per E-Mail zu, sobald Sie Ihre Anmeldung bestätigt haben. Schauen Sie auch im Spam-Ordner nach.' %>
      </small>
    </p>

    <a href="/" class="btn-back-home">
      <i class="fas fa-arrow-left"></i> <%= copy.backHome || 'Zurück zur Startseite' %>
    </a>
  </div>
</main>

    <%- include('partials/general/footer') %>
  </body>
</html>
