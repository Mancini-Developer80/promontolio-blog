<div id="cart-overlay" class="cart-overlay"></div>

<aside id="cart-sidebar" class="cart-sidebar">
  <div class="cart-header">
    <h2>Ihr Warenkorb</h2>
    <button id="close-cart" class="close-btn" aria-label="Schließen">
      &times;
    </button>
  </div>

  <div id="cart-items-container" class="cart-items">
    <p class="empty-msg">Ihr Warenkorb ist noch leer.</p>
  </div>

  <div class="cart-footer">
    <div class="cart-total">
      <span>Gesamtsumme:</span>
      <span id="cart-total-amount">0,00 €</span>
    </div>

    <button id="checkout-btn" class="btn-checkout" disabled>Zur Kasse</button>

    <p class="shipping-info">
      <small>Inkl. MwSt. zzgl. <a href="/shipping">Versandkosten</a></small>
    </p>
  </div>
</aside>
