<% const normRoute = currentRoute && currentRoute.replace(/\/$/, ''); %>
<% const navLabels = {
  de: {
    home: 'Home',
    about: 'Über uns',
    product: 'Produkte',
    blog: 'Magazin',
    cart: 'Warenkorb öffnen',
    toggle: 'Toggle menu'
  },
  it: {
    home: 'Home',
    about: 'Chi siamo',
    product: 'Prodotti',
    blog: 'Blog',
    cart: 'Apri carrello',
    toggle: 'Apri menu'
  }
}[locale || 'de'] || {
  home: 'Home',
  about: 'Über uns',
  product: 'Produkte',
  blog: 'Magazin',
  cart: 'Warenkorb öffnen',
  toggle: 'Toggle menu'
}; %>
<nav class="navbar" id="main-navbar" aria-label="Main navigation">
  <div class="navbar__container container">
    <div class="navbar__logo">
      <a href="/">
        <img
          class="navbar__logo-img"
          src="/image/logo-promontolio.png"
          alt="Promontolio Logo"
        />
      </a>
    </div>

    <div class="navbar__menu" id="navbar-menu">
      <ul class="navbar__list">
        <li class="navbar__item">
          <a
            href="/"
            class="navbar__link <%= (normRoute === '' || normRoute === '/') ? 'navbar__link--active' : '' %>"
            ><%= navLabels.home %></a
          >
        </li>
        <li class="navbar__item">
          <a
            href="/about"
            class="navbar__link <%= normRoute && normRoute.startsWith('/about') ? 'navbar__link--active' : '' %>"
            ><%= navLabels.about %></a
          >
        </li>
        <li class="navbar__item">
          <a
            href="/product"
            class="navbar__link <%= normRoute && normRoute.startsWith('/product') ? 'navbar__link--active' : '' %>"
            ><%= navLabels.product %></a
          >
        </li>
        <li class="navbar__item">
          <a
            href="/blog"
            class="navbar__link <%= normRoute && normRoute.startsWith('/blog') ? 'navbar__link--active' : '' %>"
            ><%= navLabels.blog %></a
          >
        </li>
      </ul>
    </div>

    <div class="navbar__actions">
      <div class="navbar__language-switch" aria-label="Language switcher">
        <a class="navbar__language-link <%= locale === 'de' ? 'is-active' : '' %>" href="<%= languageUrls && languageUrls.de ? languageUrls.de : '/?lang=de' %>" hreflang="de" aria-current="<%= locale === 'de' ? 'true' : 'false' %>">DE</a>
        <a class="navbar__language-link <%= locale === 'it' ? 'is-active' : '' %>" href="<%= languageUrls && languageUrls.it ? languageUrls.it : '/?lang=it' %>" hreflang="it" aria-current="<%= locale === 'it' ? 'true' : 'false' %>">IT</a>
      </div>
      <button
        id="open-cart"
        class="navbar__cart-btn"
        aria-label="<%= navLabels.cart %>"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path
            d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
          />
        </svg>
        <span id="cart-badge" class="navbar__cart-badge">0</span>
      </button>
    </div>

    <button
      class="navbar__hamburger"
      id="navbar-hamburger"
      aria-label="<%= navLabels.toggle %>"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="navbar__overlay" id="navbar-overlay"></div>
</nav>
