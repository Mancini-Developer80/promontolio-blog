<% const localizedFooter = typeof footerCopy !== 'undefined' ? footerCopy : {}; %>

<footer class="site-footer">
  <div class="footer-container container">

    <!-- Brand & Tagline -->
    <div class="footer-brand">
      <img
        src="/image/logo-promontolio.png"
        alt="Promontolio logo"
        class="footer-logo"
        loading="lazy"
      />
      <div class="footer-brand-info">
        <span class="footer-title">Promontolio</span>
        <p class="footer-tagline"><%= localizedFooter.tagline || '' %></p>
      </div>
    </div>

    <!-- Middle: Trust / Qualità + Social e Contatti -->
    <div class="footer-middle">
      <div class="footer-trust">
        <span><%= localizedFooter.trust || '' %></span>
      </div>

      <div class="footer-actions">
        <div class="footer-social">
          <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        </div>
        <div class="footer-contact">
          <a href="/contact" class="footer-link"><%= localizedFooter.contact || '' %></a>
        </div>
      </div>
    </div>

    <!-- Legal Bar -->
    <div class="footer-legal">
      <nav class="legal-nav">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/auth/login" class="admin-link">Admin Access</a>
      </nav>
      <div class="footer-copyright">
        &copy; <%= new Date().getFullYear() %> Promontolio. <%= localizedFooter.copyright || '' %>
      </div>
    </div>

  </div>
</footer>

<%- include('../cart/cart-sidebar') %>