<% const seoPage = typeof pageMeta !== 'undefined' ? pageMeta : {}; %>
<% const seoMeta = seoPage.metaTags || {}; %>
<title><%= title || seoPage.title || seoMeta.title || '' %></title>
<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, 
initial-scale=1.0"
/>
<% const description = metaDescription || seoPage.metaDescription || seoMeta.metaDescription; %>
<% const keywords = metaKeywords || seoPage.metaKeywords || seoMeta.metaKeywords; %>
<% if (description) { %>
<meta name="description" content="<%= description %>" />
<% } %> <% if (keywords) { %>
<meta name="keywords" content="<%= keywords %>" />
<% } %>
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
<link rel="canonical" href="<%= canonicalUrl %>" />
<% } %>
<% if (typeof alternateUrls !== 'undefined' && alternateUrls) { %>
<% if (alternateUrls.de) { %><link rel="alternate" hreflang="de" href="<%= alternateUrls.de %>" /><% } %>
<% if (alternateUrls.it) { %><link rel="alternate" hreflang="it" href="<%= alternateUrls.it %>" /><% } %>
<% if (canonicalUrl) { %><link rel="alternate" hreflang="x-default" href="<%= canonicalUrl %>" /><% } %>
<% } %>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
  integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>
<link rel="stylesheet" href="/css/main.css" />

<!-- Preconnect to Google Fonts for better performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Google Fonts -->
<link
  href="https://fonts.googleapis.com/css?family=Roboto:400,700&display=swap"
  rel="stylesheet"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
  rel="stylesheet"
/>

<script src="/js/script.js" defer></script>
<script src="/js/cart.js" defer></script>
