<!DOCTYPE html>
<html lang="<%= locale || 'de' %>">
  <head>
    <%- include('partials/general/head') %>
  </head>
  <body class="<%= bodyClass %>">
    <% const copy = pageCopy || {}; %>
    <%- include('partials/general/navbar') %>

    <main class="success-view">
      <section class="success-card">
        <div class="success-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
            />
          </svg>
        </div>

        <h1 class="success-title">
          <%= copy.title || 'Vielen Dank' %>, <%= customerName %>!
        </h1>

        <p class="success-text">
          <%= copy.paymentText || 'Wir haben Ihre Zahlung über' %>
          <strong><%= totalAmount %> €</strong> erhalten. <br />
          <%= copy.orderPrefix || 'Eine Bestätigung Ihrer Bestellung (Nr. #' %><%= orderId %><%= copy.orderSuffix || ') sowie die Rechnung wurden soeben an' %> <em><%= customerEmail %></em> <%= copy.sentText || 'versandt.' %>
        </p>

        <div
          class="download-guide-box"
          style="
            background: #fdfdfd;
            border: 1px solid #e0e0e0;
            padding: 25px;
            margin: 30px 0;
            border-radius: 12px;
            text-align: center;
          "
        >
          <h3 style="color: #4a5d38; margin-bottom: 12px">
            <%= copy.welcomeTitle || 'Ein Willkommensgruß aus dem Gargano 🌿' %>
          </h3>
          <p style="font-size: 0.95rem; color: #555">
            <%= copy.welcomeText || 'Während wir Ihre Bestellung für den Versand vorbereiten, laden wir Sie ein, tiefer in die Welt unseres Olivenöls einzutauchen.' %>
          </p>
          <a
            href="/download/Giuseppe_Mancini_AI_Solution_Architect_2026.pdf"
            class="btn-primary"
            style="display: inline-block; margin-top: 15px; padding: 12px 25px"
          >
            <%= copy.downloadGuide || 'PDF-Guide herunterladen' %>
          </a>
        </div>

        <div
          class="success-actions"
          style="display: flex; gap: 15px; justify-content: center"
        >
          <a href="/blog" class="btn-secondary"><%= copy.blogCta || 'Magazin & Rezepte' %></a>
          <a href="/" class="btn-primary"><%= copy.homeCta || 'Zur Startseite' %></a>
        </div>
      </section>
    </main>

    <%- include('partials/general/footer') %>

    <script src="/js/success.js" defer></script>
  </body>
</html>
