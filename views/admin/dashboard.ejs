<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/general/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <title>Promontolio Admin - Dashboard</title>
</head>
<body class="admin-page">
    <%- include('../partials/general/dashboardNavbar') %>

    <main class="admin-page-content">
        <header class="admin-header">
            <h1 class="form-title">Promontolio Dashboard</h1>
            <p>Bentornato! Ecco la panoramica della tua attività e dei tuoi lead.</p>
        </header>

        <div class="dashboard-grid">
            <div class="admin-card">
                <div class="card-content">
                    <span class="stat-number"><%= (stats && stats.totalPosts) || 0 %></span>
                    <span class="stat-label">Total Blog Posts</span>
                </div>

                    </div>

            <div class="admin-card">
                <div class="card-content">
                    <span class="stat-number"><%= (stats && stats.totalSubscribers) || 0 %></span>
                    <span class="stat-label">Newsletter Subscribers</span>
                </div>
            </div>

            <div class="admin-card">
                <div class="card-content">
                    <span class="stat-number"><%= (stats && stats.postsThisMonth) || 0 %></span>
                    <span class="stat-label">Posts This Month</span>
                </div>
            </div>

            <div class="admin-card">
                <div class="card-content">
                    <span class="stat-number"><%= (stats && stats.recentSubscribers) || 0 %></span>
                    <span class="stat-label">New Subscribers (30 days)</span>
                </div>
            </div>
        </div>

        <section class="admin-section">
            <h2 class="section-title">📬 Lead e consenso</h2>
            <div class="admin-card">
                <% if (stats && stats.recentSubscribersList && stats.recentSubscribersList.length > 0) { %>
                    <ul>
                        <% stats.recentSubscribersList.forEach((lead) => { %>
                            <li><%= lead.email %> — <%= lead.status %> — <%= lead.source %></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="no-data">Nessun lead disponibile.</p>
                <% } %>
            </div>
        </section>

        <section class="admin-section">
            <h2 class="section-title">✉️ Messaggi contatto</h2>
            <div class="admin-card">
                <% if (stats && stats.recentContactMessages && stats.recentContactMessages.length > 0) { %>
                    <ul>
                        <% stats.recentContactMessages.forEach((contact) => { %>
                            <li>
                                <strong><%= contact.name %></strong> —
                                <a href="mailto:<%= contact.email %>"><%= contact.email %></a> —
                                <%= contact.status %>
                                <br />
                                <span><%= contact.message %></span>
                                <br />
                                <small><%= new Date(contact.createdAt).toLocaleString('it-IT') %></small>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="no-data">Nessun messaggio contatto disponibile.</p>
                <% } %>
            </div>
        </section>

        <section class="analytics-grid">
            <div class="chart-box">
                <div class="chart-header">
                    <h3>📊 Pubblicazioni (Ultimi 6 Mesi)</h3>
                </div>
                <div class="chart-container">
                    <canvas id="postsChart"></canvas>
                </div>
            </div>

            <div class="chart-box">
                <div class="chart-header">
                    <h3>📈 Crescita Iscritti</h3>
                </div>
                <div class="chart-container">
                    <canvas id="subscribersChart"></canvas>
                </div>
            </div>

            <div class="chart-box">
                <div class="chart-header">
                    <h3>🏷️ Categorie Popolari</h3>
                </div>
                <div class="chart-container">
                    <canvas id="categoriesChart"></canvas>
                </div>
            </div>

            <div class="chart-box performance-insights">
                <div class="chart-header">
                    <h3>🏆 Top Performing Content</h3>
                </div>
                <div class="performance-list">
                    <% if (analytics && analytics.topPosts && analytics.topPosts.length > 0) { %>
                        <% analytics.topPosts.slice(0, 5).forEach((post, index) => { %>
                            <div class="admin-article-card">
                                <div class="article-info">
                                    <h4>#<%= index + 1 %> <%= post.title %></h4>
                                    <span><i class="fas fa-eye"></i> <%= post.viewCount || 0 %> views</span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="no-data">Nessun dato disponibile.</p>
                    <% } %>
                </div>
            </div>
        </section>

        <section class="admin-section">
            <h2 class="section-title">⚡ Azioni Rapide</h2>
            <div class="quick-actions">
                <a href="/admin/blog/new" class="btn-admin btn-create">✍️ Nuovo Post</a>
                <a href="/admin/blog" class="btn-admin btn-gold">📝 Gestisci Post</a>
                <a href="/admin/users" class="btn-admin btn-info">👥 Utenti</a>
                <a href="/blog" class="btn-admin btn-info" target="_blank">🌐 Vedi Sito</a>
                <a href="/auth/logout" class="btn-admin btn-danger">🚪 Logout</a>
            </div>
        </section>

        <section class="admin-section">
            <h2 class="section-title">🌱 Strategia Promontolio</h2>
            <div class="dashboard-grid">
                <div class="admin-card">
                    <h4>📝 Idee Contenuti</h4>
                    <p>Scrivi della raccolta nel Gargano e dei benefici dell'olio EVO.</p>
                </div>
                <div class="admin-card">
                    <h4>👥 Engagement</h4>
                    <p>Condividi ricette tradizionali per convertire i lead del blog.</p>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/general/adminFooter') %>

    <div id="analytics-data" style="display: none" data-analytics="<%- JSON.stringify(analytics || {}) %>"></div>

    <script src="/js/admin-dashboard.js" defer></script>
</body>
</html>