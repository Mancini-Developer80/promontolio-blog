<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/general/head') %>
    <title><%= title %> - Promontolio Admin</title>
    
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</head>
<body class="admin-page">
    <%- include('../partials/general/dashboardNavbar') %>

    <div class="admin-container">
        <form action="<%= article.id ? '/admin/blog/' + article.id + '/edit' : '/admin/blog/new' %>" 
              method="POST" 
              enctype="multipart/form-data"
              class="form-card">
            
            <div class="form-header">
                <h1><i class="fas fa-edit"></i> <%= title %></h1>
            </div>

            <div class="form-body">
                <div class="form-group">
                    <label for="title">Titolo Articolo *</label>
                    <input type="text" id="title" name="title" value="<%= article.title || '' %>" required maxlength="100">
                </div>

                <div class="form-row" style="display: flex; gap: 1rem;">
                    <div class="form-group" style="flex: 1;">
                        <label for="category">Categoria</label>
                        <select id="category" name="category">
                            <option value="recipes" <%= article.category === 'RECIPES' ? 'selected' : '' %>>Ricette</option>
                            <option value="olive-oil-guide" <%= article.category === 'OLIVE_OIL_GUIDE' ? 'selected' : '' %>>Guida Olio</option>
                            <option value="production" <%= article.category === 'PRODUCTION' ? 'selected' : '' %>>Produzione</option>
                            <option value="health-benefits" <%= article.category === 'HEALTH_BENEFITS' ? 'selected' : '' %>>Salute</option>
                            <option value="news" <%= article.category === 'NEWS' ? 'selected' : '' %>>News</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="excerpt">Estratto (SEO)</label>
                    <textarea id="excerpt" name="excerpt" rows="2"><%= article.excerpt || '' %></textarea>
                </div>

                <div class="form-group">
                    <label>Contenuto *</label>
                    <div id="editor-container"></div>
                    <input type="hidden" name="content" id="content-input" value="<%= article.content || '' %>">
                </div>

                <div class="form-group">
                    <label for="featuredImage">Immagine in evidenza</label>
                    <input type="file" id="featuredImage" name="featuredImage" accept="image/*">
                    <% if (article.featuredImage) { %>
                        <p><small>Immagine attuale: <%= article.featuredImage %></small></p>
                    <% } %>
                </div>

                <div class="form-actions" style="margin-top: 2rem; border-top: 1px solid #eee; padding-top: 1.5rem; text-align: right;">
                    <a href="/admin/blog" class="btn btn-secondary">Annulla</a>
                    <button type="submit" name="action" value="draft" class="btn btn-outline-primary">Salva Bozza</button>
                    <button type="submit" name="action" value="publish" class="btn btn-success">Pubblica</button>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    
    <script src="/js/admin-blog-editor.js"></script>
</body>
</html>