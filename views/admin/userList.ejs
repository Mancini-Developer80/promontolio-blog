<!DOCTYPE html>
<html lang="it">
  <head>
    <%- include('../partials/general/head') %>
    <title>Gestione Utenti - Promontolio</title>
  </head>
<body class="admin-page">
    <%- include('../partials/general/dashboardNavbar') %>

    <main class="admin-page-content">
        <header class="admin-header">
            <h1 class="form-title"><i class="fas fa-users"></i> Gestione Utenti</h1>
            <a href="/admin/users/new" class="btn btn-success">
                <i class="fas fa-user-plus"></i> Nuovo Utente
            </a>
        </header>

        <%- include('../partials/alerts') %>

        <div class="dashboard-grid">
            <div class="admin-card"><div class="card-content" style="text-align:center">
                    <div class="h2 font-weight-bold" style="color:var(--adm-accent, #4f6f27)"><%= stats.active %></div>
                    <div class="text-muted small">Utenti Attivi</div>
            </div></div>
            <div class="admin-card"><div class="card-content" style="text-align:center">
                    <div class="h2 font-weight-bold" style="color:var(--adm-accent, #4f6f27)"><%= stats.admins %></div>
                    <div class="text-muted small">Amministratori</div>
            </div></div>
            <div class="admin-card"><div class="card-content" style="text-align:center">
                    <div class="h2 font-weight-bold" style="color:var(--adm-accent, #4f6f27)"><%= stats.total %></div>
                    <div class="text-muted small">Totale</div>
            </div></div>
        </div>

        <% if (users && users.length > 0) { %>
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Info Utente</th>
                        <th>Ruolo</th>
                        <th>Stato</th>
                        <th>Azioni</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    <% users.forEach(userItem => { %>
                    <tr data-status="<%= userItem.status.toLowerCase() %>" 
                        data-role="<%= userItem.role.toLowerCase() %>" 
                        data-search="<%= (userItem.firstName + ' ' + userItem.lastName + ' ' + userItem.email).toLowerCase() %>">
                        <td>
                            <div class="user-info">
                                <div class="font-weight-bold"><%= userItem.firstName %> <%= userItem.lastName %></div>
                                <div class="text-muted small"><%= userItem.email %></div>
                            </div>
                        </td>
                        <td><span class="badge badge-info"><%= userItem.role %></span></td>
                        <td>
                            <span class="badge <%= userItem.status === 'ACTIVE' ? 'badge-success' : 'badge-danger' %>">
                                <%= userItem.status %>
                            </span>
                        </td>
                        <td>
                            <div class="user-actions">
                                <a href="/admin/users/<%= userItem.id %>/edit" class="btn btn-outline-primary btn-sm"><i class="fas fa-edit"></i></a>
                                <% if (user.id !== userItem.id) { %>
                                <form method="POST" action="/admin/users/<%= userItem.id %>/toggle-status" style="display:inline;">
                                    <button type="submit" class="btn btn-outline-warning btn-sm"><i class="fas fa-sync"></i></button>
                                </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div class="alert alert-info">Nessun utente trovato.</div>
        <% } %>
    </main>

    <script src="/js/admin-users.js"></script>
</body>
</html>