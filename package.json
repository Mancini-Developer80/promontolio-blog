{
  "name": "Promontolio",
  "version": "1.0.0",
  "description": "Web site to promote the product and collect data for the dashboard",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:sass && npx prisma generate",
    "build:sass": "sass sass:public/css --style=compressed",
    "watch:sass": "sass sass:public/css --watch --no-source-map",
    "dev": "nodemon server.js",
    "test": "node --test tests/i18n.test.js tests/link-health.test.js tests/public-controller.test.js tests/contact-form.test.js tests/validation.test.js tests/http-smoke.test.js",
    "dev:all": "npm run docker:up && concurrently \"npm run dev\" \"npm run watch:sass\"",
    "docker:up": "docker-compose up -d",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "setup": "npm run docker:up && npm run db:migrate && node scripts/createSuperuser.js",
    "audit:ai": "python3 ai_audit_tool.py"
  },
  "author": "Giuseppe Mancini",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@quixo3/prisma-session-store": "^3.1.19",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.17.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "stripe": "^20.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.2",
    "sass": "^1.90.0",
    "supertest": "^7.3.2"
  }
}
