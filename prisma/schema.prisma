generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  AUTHOR
  EDITOR
  ADMIN
  SUPER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum Category {
  OLIVE_OIL_GUIDE
  RECIPES
  HEALTH_BENEFITS
  PRODUCTION
  NEWS
}

enum LeadStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum MediaCategory {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

// --- MODELLI ---

model User {
  id                   Int          @id @default(autoincrement())
  username             String       @unique
  email                String       @unique
  password             String
  firstName            String?      @db.VarChar(50)
  lastName             String?      @db.VarChar(50)
  role                 UserRole     @default(AUTHOR)
  status               UserStatus   @default(ACTIVE)
  avatar               String?
  bio                  String?      @db.VarChar(500)
  lastLogin            DateTime?
  loginCount           Int          @default(0)
  emailVerified        Boolean      @default(false)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  mustChangePassword   Boolean      @default(false)
  
  // Relazioni
  articles             Article[]
  uploadedMedia        Media[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Article {
  id              Int           @id @default(autoincrement())
  title           String        @db.VarChar(150) // Aumentato a 150 per titoli lunghi in tedesco
  slug            String        @unique
  content         String        @db.Text
  excerpt         String?       @db.VarChar(500)
  status          ArticleStatus @default(DRAFT)
  category        Category?
  featuredImage   String?       // URL o path dell'immagine di copertina
  metaDescription String?       @db.VarChar(160)
  
 
  language        String        @default("de") @db.VarChar(5) // "de" o "it"
  
  
  tags            String[]      @default([])

  viewCount       Int           @default(0)
  readingTime     Int           @default(3) // Minuti di lettura stimati

  // 👤 AUTORE FACOLTATIVO (Per evitare errori se creato automaticamente)
  authorId        Int?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([language]) // Indice fondamentale per filtrare rapidamente gli articoli per lingua!
  @@index([status, language])
}

model Media {
  id           Int           @id @default(autoincrement())
  filename     String        @unique
  originalName String
  mimetype     String        // Nota: ho usato 'mimetype' tutto minuscolo come nel tuo primo modello
  size         Int
  path         String        // Percorso locale o URL Cloud Storage
  url          String
  alt          String        @default("")
  title        String        @default("")
  description  String        @default("")
  category     MediaCategory @default(OTHER)
  width        Int?
  height       Int?
  usageCount   Int           @default(0)
  tags         String[]      // Supportato nativamente da PostgreSQL!

  // Relazione corretta con l'utente
  uploadedById Int
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([category])
  @@index([mimetype])
}

model Lead {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  status    LeadStatus @default(PENDING)
  consent   Boolean    @default(false)
  source    String     @default("PDF_Guide_Organic_Oil")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @default(uuid())
  confirmed Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Setting {
  key       String   @id
  value     Json     // Questo campo ospiterà tutto l'oggetto settings (site, content, uploads, etc.)
  updatedAt DateTime @updatedAt
}
